# ============================================
# AI 역사 모의 법정 - 환경 변수 예시
# ============================================

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/hist_court
DATABASE_URL_TEST=postgresql://postgres:password@localhost:5432/hist_court_test

# Backend FastAPI
BACKEND_URL=http://localhost:8000
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b

# Frontend Next.js
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=AI 역사 모의 법정

# Google Sheets (선생님 대시보드에서 설정)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# CORS
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# Redis (선택사항 - 세션 캐싱)
REDIS_URL=redis://localhost:6379
