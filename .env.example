# ---------------------------------------------------------------------------
# Supabase (필수)
# Supabase 대시보드 > Project Settings > API 에서 확인
# 프로젝트 리전은 서울(ap-northeast-2) 권장
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# 단계별 선택 기능 (true / false)
# ---------------------------------------------------------------------------

# 2단계: 능력치 · 코치 메모 · 시즌 기록 + 승인 워크플로우
# false 로 두면 관련 메뉴와 라우트가 노출되지 않고 1단계 기능만 동작한다.
NEXT_PUBLIC_ENABLE_PLAYER_ABILITIES=false

# 3단계: 구글 드라이브 영상 연동 + 타임스탬프 분석 메모
NEXT_PUBLIC_ENABLE_VIDEOS=false

# 선수 데이터베이스를 로그인하지 않은 방문자에게도 공개할지 여부.
# 학교 구성원 한정으로 운영하려면 false 로 바꾼다(관리자만 /players 접근 가능).
NEXT_PUBLIC_PUBLIC_PLAYER_DIRECTORY=true

# ---------------------------------------------------------------------------
# 학생 계정 (교사 발급)
# ---------------------------------------------------------------------------

# 학생 계정 발급에 필요한 Supabase 관리자 키.
# 절대 NEXT_PUBLIC_ 을 붙이지 말 것 — 붙이면 브라우저로 새어 나간다.
# 이 키는 모든 권한을 우회하므로 서버 환경변수로만 둔다.
# 비워 두면 발급 기능만 꺼지고 나머지는 정상 동작한다.
SUPABASE_SERVICE_ROLE_KEY=

# 학생 로그인 아이디에 붙는 도메인. 실제 메일 주소가 아니며 메일은 보내지 않는다.
# 기본값은 RFC 2606 이 예약한 .invalid 라 바깥으로 메일이 샐 수 없다.
NEXT_PUBLIC_STUDENT_ACCOUNT_DOMAIN=students.invalid

# ---------------------------------------------------------------------------
# 학생 로그인 (구글) — 학교에 구글 워크스페이스가 있을 때만
# ---------------------------------------------------------------------------

# 구글 로그인 버튼 노출 여부. 학교에 구글 계정이 없으면 false 로 둔다.
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false

# 구글 로그인 화면에서 학교 도메인 계정을 먼저 보여 준다. 비워 두면 모든 구글 계정이 뜬다.
# 실제 도메인 제한은 Supabase 대시보드의 구글 공급자 설정에서 지정해야 한다.
NEXT_PUBLIC_SCHOOL_DOMAIN=school.kr

# 배포 주소. 로그인 후 돌아올 곳을 정할 때 쓴다(요청 헤더로 알 수 없는 경우 대비).
NEXT_PUBLIC_SITE_URL=https://league.school.kr
